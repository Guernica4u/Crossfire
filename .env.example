# Get a free key at https://openrouter.ai/settings/keys
# Use free models only. Do not add credits.
OPENROUTER_API_KEY=

# Public URL used for OpenRouter attribution headers.
NEXT_PUBLIC_SITE_URL=https://site-2a4337a8b0494c409d081c6612ae611d.freebuff.page

# Required for the public key pool. Use a long random server-side value and
# keep it stable; changing it makes existing encrypted pool entries unreadable.
CROSSFIRE_POOL_SECRET=use-a-long-random-server-side-value

# Local development only. Windows uses Node's built-in SQLite by default
# because the Workers runtime cannot always start there. Set this on any
# platform to force the SQLite fallback, or CROSSFIRE_USE_WORKERD=1 to force
# the local D1 emulator.
# CROSSFIRE_LOCAL_DB=1
